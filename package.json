{
  "name": "bible-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:bible",
    "dev": "vite --port 5203",
    "prebuild": "npm run build:bible",
    "build": "vite build",
    "build:bible": "node scripts/build-bible-books.mjs",
    "lint": "eslint .",
    "generate:bible-source-lock": "node scripts/generate-bible-source-lock.mjs",
    "generate:bible-source-corrections": "node scripts/generate-bible-source-corrections.mjs",
    "parse:bible-markdown": "node scripts/parse-bible-markdown.mjs",
    "test": "node --test src/data/bibleData.test.js src/data/bibleRepository.test.js src/data/bibleOfflineStorage.test.js src/utils/readingProgress.test.js src/utils/readerPreferences.test.js src/utils/readerPreferenceStyle.test.js src/utils/readerFocus.test.js src/utils/readerPosition.test.js src/utils/readerNavigation.test.js src/utils/readerBookmarks.test.js scripts/bible-source-lock-lib.test.mjs scripts/bible-source-corrections-lib.test.mjs scripts/bible-markdown-parser-lib.test.mjs scripts/build-bible-books-lib.test.mjs",
    "verify:bible-source": "node scripts/verify-bible-source.mjs",
    "validate:bible-source-content": "node scripts/validate-bible-source-content.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
